{
  "redirects": [
    {
      "source": "/diago-spice-bar-menu.pdf",
      "destination": "/diago-spice-menu.pdf",
      "permanent": true
    },
    {
      "source": "/staff",
      "destination": "/staff/",
      "permanent": true
    }
  ],
  "functions": {
    "api/staff/menu.ts": {
      "includeFiles": "private/encrypted/**"
    },
    "api/menu.ts": {
      "includeFiles": "private/encrypted/*.json.enc"
    },
    "api/offers.ts": {
      "includeFiles": "private/encrypted/*.json.enc"
    },
    "api/staff/content.ts": {
      "includeFiles": "private/encrypted/*.json.enc"
    },
    "api/staff/publish.ts": {
      "includeFiles": "private/encrypted/*.json.enc"
    }
  },
  "headers": [
    {
      "source": "/staff/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/staff/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(restaurant-menu|bar-menu|offers)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(poster|qr)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
