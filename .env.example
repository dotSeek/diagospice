# Diago Spice staff portal. Copy to .env, or run: npm run staff:credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
STAFF_USERNAME=staff
STAFF_PASSWORD=
# 32 random bytes, base64. Signs the login cookie.
SESSION_SECRET=
# 32 random bytes, base64. Decrypts private/encrypted/*.enc. Must match the key used to build them.
MENU_FILES_KEY=
